# ─── ASR API Configuration ──────────────────────────────────────
ASR_BASE_URL=https://asrv2prod.shunyalabs.ai
ASR_API_KEY=<your-api-key>

# ─── Auth ────────────────────────────────────────────────────────
AUTH_TOKEN_ENDPOINT=/auth/token
TOKEN_REFRESH_BUFFER_SECONDS=120

# ─── Test Configuration ─────────────────────────────────────────
DEFAULT_MODEL=zero-indic
DEFAULT_TIMEOUT_MS=600000
API_TIMEOUT_MS=120000
HEALTH_TIMEOUT_MS=5000
STREAMING_TIMEOUT_MS=60000

# Accuracy thresholds
ASR_WER_THRESHOLD=0.80
ASR_CER_THRESHOLD=0.40

# Performance thresholds
LATENCY_P50_THRESHOLD_MS=5000
LATENCY_P95_THRESHOLD_MS=15000
CONCURRENT_REQUEST_COUNT=5
STRESS_REQUEST_COUNT=50
RATE_LIMIT_WINDOW_MS=1000

# ─── Audio Fixtures ──────────────────────────────────────────────
AUDIO_FIXTURES_DIR=input/audio
TEST_AUDIO_FILE_WAV=input/audio/reference/hi_in_0.wav
TEST_AUDIO_FILE_FLAC=input/audio/reference/hi_in_0.wav
TEST_AUDIO_FILE_OGG=input/audio/reference/PeopleAreKnowledge_Gillidanda_Interview1.ogg
TEST_AUDIO_FILE_8KHZ=input/audio/reference/hi_in_0.wav
TEST_AUDIO_FILE_16KHZ=input/audio/reference/hi_in_0.wav
TEST_AUDIO_FILE_STEREO=input/audio/reference/hinglish_arti.wav
TEST_AUDIO_FILE_LARGE=input/audio/reference/hinglish_arti.wav
TEST_AUDIO_FILE_OVERSIZED=input/audio/reference/hinglish_arti.wav
TEST_AUDIO_FILE_CORRUPTED=input/audio/edge/corrupted.wav
TEST_AUDIO_FILE_EMPTY=input/audio/edge/empty.wav
TEST_AUDIO_FILE_SILENT=input/audio/edge/silence.wav
TEST_AUDIO_FILE_SHORT=input/audio/edge/short.wav
TEST_AUDIO_FILE_PROFANE=input/audio/reference/hinglish_arti.wav
TEST_AUDIO_URL=https://example.com/sample.wav

# ─── Google Sheets ───────────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_JSON=Google_service_account.json
# GOOGLE_SERVICE_ACCOUNT_JSON_64=<base64-encoded-json>
GOOGLE_SHEET_ID=<output-spreadsheet-id>

# ─── Email Reports ───────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<sender-email>
SMTP_PASS=<app-password>
REPORT_EMAIL_TO=yamini@unitedwecare.com
REPORT_EMAIL_FROM=<sender-email>
REPORT_BASE_URL=https://yamini-pal-singh.github.io/automation-testing
